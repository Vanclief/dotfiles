#!/usr/bin/env bash
# macOS system settings. Idempotent: run after a fresh install or whenever
# these drift. Settings that stay at Apple's defaults are left out.
#
#   ~/dotfiles/macos
#
# The modifier mapping takes effect when the keyboard reconnects or at next
# login. Everything else applies once Dock and Finder restart at the end.
set -euo pipefail

if [ "$(uname -s)" != "Darwin" ]; then
  echo "macos: not macOS, nothing to do" >&2
  exit 0
fi

# --- Trackpad --------------------------------------------------------------

# Scroll direction: not "natural".
defaults write -g com.apple.swipescrolldirection -bool false

# Tap to click off, two-finger secondary click on, three-finger drag off.
defaults write com.apple.AppleMultitouchTrackpad Clicking -bool false
defaults write com.apple.AppleMultitouchTrackpad TrackpadRightClick -bool true
defaults write com.apple.AppleMultitouchTrackpad TrackpadThreeFingerDrag -bool false
defaults -currentHost write -g com.apple.trackpad.enableSecondaryClick -bool true
defaults -currentHost write -g com.apple.trackpad.threeFingerDragGesture -bool false

# --- Keyboard --------------------------------------------------------------

# Kinesis Advantage2 (vendor 10730, product 258): Caps Lock -> Right Control.
# Same thing System Settings > Keyboard > Modifier Keys writes. HID usages:
# 0x700000039 Caps Lock = 30064771129, 0x7000000E4 Right Control = 30064771300.
defaults -currentHost write -g com.apple.keyboard.modifiermapping.10730-258-0 -array \
  '<dict>
     <key>HIDKeyboardModifierMappingSrc</key><integer>30064771129</integer>
     <key>HIDKeyboardModifierMappingDst</key><integer>30064771300</integer>
   </dict>'

# --- Appearance ------------------------------------------------------------

# Follow the system light/dark schedule.
defaults write -g AppleInterfaceStyleSwitchesAutomatically -bool true

# --- Dock ------------------------------------------------------------------

defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock orientation -string left
defaults write com.apple.dock tilesize -int 47
defaults write com.apple.dock show-recents -bool false

# Don't reorder Spaces by most recent use.
defaults write com.apple.dock mru-spaces -bool false

# --- Finder ----------------------------------------------------------------

# Column view by default.
defaults write com.apple.finder FXPreferredViewStyle -string clmv

# --- Apply -----------------------------------------------------------------

killall Dock Finder 2>/dev/null || true
echo "macos: settings applied"
